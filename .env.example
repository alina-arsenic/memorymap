# App settings
PROJECT_NAME=memorymap
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://api:8000

# PostgreSQL
POSTGRES_DB=memorymap
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=mmsecret
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# S3 (MinIO)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=memorymap-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false

# Telegram Bot
TELEGRAM_BOT_TOKEN=put_your_token_here
TELEGRAM_WEBHOOK_SECRET=mm-secret
TELEGRAM_WEBHOOK_URL=http://api:8000/bot/webhook